# Copy this file to .env (same folder) and fill in the values.
# .env is private: git ignores it, so it is never uploaded to GitHub.
# Put each value straight after the = sign, with no spaces or quotes.

# Google sign-in for staff (Google Cloud Console > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Only on the computer that hosts the live site ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=   (a long random value; see README "Hosting on a Windows computer")
# DJANGO_ALLOWED_HOSTS=www.your-school-domain.com,your-school-domain.com
# SITE_URL=https://www.your-school-domain.com
# DJANGO_BEHIND_PROXY=1
# BACKUP_DIR=D:\school-backups
